---
import { getLangFromLocale, useTranslations } from '../i18n/utils'

const lang = getLangFromLocale(Astro.currentLocale)
const t = useTranslations(lang)
---

<section id="contact" class="section contact">
  <div class="container">
    <span class="section-label reveal">{t('contact.label')}</span>
    <h2 class="contact-title reveal reveal-delay-1">
      {t('contact.title.line1')}<br />{t('contact.title.line2')}
    </h2>
    <p class="contact-subtitle reveal reveal-delay-2">
      {t('contact.subtitle')}
    </p>

    <div class="contact-links reveal reveal-delay-3">
      <a
        href="https://t.me/aandrosov"
        class="contact-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t('contact.telegram.aria')}
      >
        <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21.2 4.6 2.4 11.4c-.6.2-.6 1.1.1 1.3l4.8 1.6 1.8 5.8c.1.5.8.6 1.1.2l2.6-3.2 5.1 3.8c.4.3 1 .1 1.1-.4L22 5.5c.1-.6-.4-1.1-.8-.9Z" />
          <path d="m9.1 14.3 8.3-7.3" />
        </svg>
        <span class="contact-link-label">Telegram</span>
        <span class="contact-link-handle">@aandrosov</span>
      </a>

      <a
        href="https://max.ru/u/f9LHodD0cOKp-JyR3RK_tx1FMWwVwuE9rvCqMr0IHY_Iy2-BTLN3S7DdY6Q"
        class="contact-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t('contact.max.aria')}
      >
        <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z" />
        </svg>
        <span class="contact-link-label">Max</span>
        <span class="contact-link-handle">max.ru</span>
      </a>

      <a
        href="mailto:aandrosov.primary@gmail.com"
        class="contact-link"
        aria-label={t('contact.email.aria')}
      >
        <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2" />
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
        </svg>
        <span class="contact-link-label">{t('contact.email.label')}</span>
        <span class="contact-link-handle">aandrosov.primary@gmail.com</span>
      </a>
    </div>
  </div>
</section>

<style>
  .contact {
    text-align: center;
  }

  .contact .section-label {
    display: block;
  }

  .contact-title {
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-snug);
    margin-bottom: var(--space-lg);
  }

  .contact-subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-3xl);
    max-width: 480px;
    margin-inline: auto;
  }

  .contact-links {
    display: flex;
    justify-content: center;
    gap: var(--space-xl);
    flex-wrap: wrap;
  }

  .contact-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-2xl) var(--space-2xl);
    min-width: 200px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: border-color var(--transition-base), transform var(--transition-base);
  }

  .contact-link:hover {
    border-color: var(--color-accent);
    transform: translateY(-3px);
  }

  .contact-icon {
    width: 28px;
    height: 28px;
    color: var(--color-accent);
    margin-bottom: var(--space-xs);
  }

  .contact-link-label {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
  }

  .contact-link-handle {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .contact-links {
      flex-direction: column;
      align-items: center;
    }

    .contact-link {
      width: 100%;
      max-width: 320px;
    }

    .contact-title {
      font-size: var(--font-size-3xl);
    }

    .contact-subtitle {
      font-size: var(--font-size-base);
      margin-bottom: var(--space-2xl);
    }
  }

  @media (max-width: 480px) {
    .contact-link {
      max-width: 100%;
      padding: var(--space-xl) var(--space-lg);
      flex-direction: row;
      gap: var(--space-md);
      min-width: 0;
    }

    .contact-icon {
      width: 24px;
      height: 24px;
      margin-bottom: 0;
      flex-shrink: 0;
    }

    .contact-link-label {
      font-size: var(--font-size-sm);
    }

    .contact-link-handle {
      word-break: break-all;
      text-align: left;
    }

    .contact-subtitle {
      font-size: var(--font-size-sm);
    }
  }
</style>
