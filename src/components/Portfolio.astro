---
import { getCollection } from 'astro:content'
import { getLangFromLocale, useTranslations } from '../i18n/utils'

const lang = getLangFromLocale(Astro.currentLocale)
const t = useTranslations(lang)

const allProjects = await getCollection('portfolio')
const projects = allProjects
  .filter((entry) => entry.data.lang === lang)
  .sort((a, b) => a.data.order - b.data.order)

const getProjectLink = (id: string) => {
  const cleanId = id.replace(/^(ru|en)\//, '')
  return lang === 'ru' ? `/portfolio/${cleanId}` : `/portfolio/en/${cleanId}`
}
---

<section id="portfolio" class="section portfolio">
  <div class="container">
    <span class="section-label reveal">{t('portfolio.label')}</span>
    <h2 class="section-title reveal reveal-delay-1">{t('portfolio.title')}</h2>

    <div class="portfolio-wrapper reveal reveal-delay-2">
      <div class="portfolio-track">
        {projects.map((project) => {
          const link = getProjectLink(project.id)
          const categoryText = project.data.categoryKey ? t(project.data.categoryKey as any) : project.data.category
          return (
            <a href={link} class="portfolio-card">
              <div class="portfolio-image-wrapper">
                <img
                  src={project.data.image}
                  alt={`${t('portfolio.altPrefix')} ${project.data.title}`}
                  class="portfolio-image"
                  width="640"
                  height="360"
                  loading="lazy"
                />
              </div>
              <div class="portfolio-info">
                <span class="portfolio-category">{categoryText}</span>
                <h3 class="portfolio-title">{project.data.title}</h3>
              </div>
            </a>
          )
        })}
      </div>
    </div>
  </div>
</section>

<script>
  const portfolioWrapper = document.querySelector('.portfolio-wrapper')
  const portfolioTrack = document.querySelector('.portfolio-track')

  if (portfolioWrapper && portfolioTrack) {
    portfolioTrack.addEventListener('scroll', () => {
      portfolioWrapper.classList.toggle('is-scrolled', portfolioTrack.scrollLeft > 8)
    }, { passive: true })
  }
</script>

<style>
  .portfolio-wrapper {
    position: relative;
  }

  /* fade edges to hint at scrollable content */
  .portfolio-wrapper::before,
  .portfolio-wrapper::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 48px;
    z-index: 2;
    pointer-events: none;
  }

  .portfolio-wrapper::before {
    left: 0;
    background: linear-gradient(to right, var(--color-bg), transparent);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .portfolio-wrapper.is-scrolled::before {
    opacity: 1;
  }

  .portfolio-wrapper::after {
    right: 0;
    background: linear-gradient(to left, var(--color-bg), transparent);
  }

  .portfolio-track {
    display: flex;
    gap: var(--space-xl);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--container-padding);
    -webkit-overflow-scrolling: touch;
    padding-bottom: var(--space-sm);
    scrollbar-width: none;
  }

  .portfolio-track::-webkit-scrollbar {
    display: none;
  }

  .portfolio-card {
    flex: 0 0 380px;
    max-width: 85vw;
    scroll-snap-align: start;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    transition: border-color var(--transition-base), transform var(--transition-base);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }

  .portfolio-card:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-4px);
  }

  .portfolio-image-wrapper {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .portfolio-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .portfolio-card:hover .portfolio-image {
    transform: scale(1.04);
  }

  .portfolio-info {
    padding: var(--space-lg);
  }

  .portfolio-category {
    display: inline-block;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-xs);
  }

  .portfolio-title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
  }

  @media (max-width: 768px) {
    .portfolio-card {
      flex: 0 0 320px;
    }

    .portfolio-wrapper::before,
    .portfolio-wrapper::after {
      width: 24px;
    }
  }

  @media (max-width: 480px) {
    .portfolio-card {
      flex: 0 0 280px;
    }

    .portfolio-info {
      padding: var(--space-md);
    }

    .portfolio-title {
      font-size: var(--font-size-base);
    }

    .portfolio-wrapper::before,
    .portfolio-wrapper::after {
      width: 16px;
    }
  }
</style>
