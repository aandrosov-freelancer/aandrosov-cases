---
import { getCollection } from 'astro:content'
import { getLangFromLocale, useTranslations } from '../i18n/utils'

const lang = getLangFromLocale(Astro.currentLocale)
const t = useTranslations(lang)

const allProjects = await getCollection('portfolio')
const projects = allProjects
  .filter((entry) => entry.data.lang === lang)
  .sort((a, b) => a.data.order - b.data.order)

const getProjectLink = (id: string) => {
  const cleanId = id.replace(/^(ru|en)\//, '')
  return lang === 'ru' ? `/portfolio/${cleanId}` : `/portfolio/en/${cleanId}`
}
---

<section id="portfolio" class="section portfolio">
  <div class="container">
    <span class="section-label reveal">{t('portfolio.label')}</span>
    <h2 class="section-title reveal reveal-delay-1">{t('portfolio.title')}</h2>

    <div class="portfolio-wrapper reveal reveal-delay-2">
      <div class="portfolio-track">
        {projects.map((project) => {
          const link = getProjectLink(project.id)
          const categoryText = project.data.categoryKey ? t(project.data.categoryKey as any) : project.data.category
          return (
            <a href={link} class="portfolio-card">
              <div class="portfolio-image-wrapper">
                <img
                  src={project.data.image}
                  alt={`${t('portfolio.altPrefix')} ${project.data.title}`}
                  class="portfolio-image"
                  width="640"
                  height="360"
                  loading="lazy"
                />
              </div>
              <div class="portfolio-info">
                <span class="portfolio-category">{categoryText}</span>
                <h3 class="portfolio-title">{project.data.title}</h3>
              </div>
            </a>
          )
        })}
      </div>
    </div>
  </div>
</section>

<script>
  const portfolioWrapper = document.querySelector('.portfolio-wrapper') as HTMLElement
  const portfolioTrack = document.querySelector('.portfolio-track') as HTMLElement

  if (portfolioWrapper && portfolioTrack) {
    let isAutoScrollStopped = false
    let autoScrollInterval: number | undefined
    let isProgrammaticScroll = false

    const stopAutoScrollPermanently = () => {
      if (isAutoScrollStopped) return
      isAutoScrollStopped = true
      if (autoScrollInterval) {
        clearInterval(autoScrollInterval)
        autoScrollInterval = undefined
      }
    }

    portfolioWrapper.addEventListener('pointerdown', stopAutoScrollPermanently, { passive: true })
    portfolioWrapper.addEventListener('touchstart', stopAutoScrollPermanently, { passive: true })
    portfolioWrapper.addEventListener('wheel', stopAutoScrollPermanently, { passive: true })

    portfolioTrack.addEventListener('scroll', () => {
      portfolioWrapper.classList.toggle('is-scrolled', portfolioTrack.scrollLeft > 8)
      if (!isProgrammaticScroll) {
        stopAutoScrollPermanently()
      }
    }, { passive: true })

    const getClosestCardIndex = () => {
      const cards = Array.from(portfolioTrack.children) as HTMLElement[]
      if (cards.length === 0) return 0
      const firstOffset = cards[0].offsetLeft
      const currentScroll = portfolioTrack.scrollLeft
      let minDiff = Infinity
      let closestIdx = 0

      cards.forEach((card, idx) => {
        const pos = card.offsetLeft - firstOffset
        const diff = Math.abs(currentScroll - pos)
        if (diff < minDiff) {
          minDiff = diff
          closestIdx = idx
        }
      })
      return closestIdx
    }

    const startAutoScroll = () => {
      if (autoScrollInterval) clearInterval(autoScrollInterval)
      autoScrollInterval = window.setInterval(() => {
        if (isAutoScrollStopped) {
          if (autoScrollInterval) clearInterval(autoScrollInterval)
          return
        }
        const cards = Array.from(portfolioTrack.children) as HTMLElement[]
        if (cards.length < 2) return

        const maxScroll = portfolioTrack.scrollWidth - portfolioTrack.clientWidth
        if (maxScroll <= 0) return

        const currentIdx = getClosestCardIndex()
        let nextIdx = currentIdx + 1

        const firstOffset = cards[0].offsetLeft
        let targetLeft = cards[nextIdx] ? cards[nextIdx].offsetLeft - firstOffset : 0

        if (nextIdx >= cards.length || targetLeft > maxScroll + 5) {
          targetLeft = 0
        }

        if (isAutoScrollStopped) {
          if (autoScrollInterval) clearInterval(autoScrollInterval)
          return
        }
        isProgrammaticScroll = true
        portfolioTrack.scrollTo({ left: targetLeft, behavior: 'smooth' })
        setTimeout(() => {
          isProgrammaticScroll = false
        }, 800)
      }, 3500)
    }

    startAutoScroll()
  }
</script>

<style>
  .portfolio-wrapper {
    position: relative;
  }

  /* fade edges to hint at scrollable content */
  .portfolio-wrapper::before,
  .portfolio-wrapper::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 48px;
    z-index: 2;
    pointer-events: none;
  }

  .portfolio-wrapper::before {
    left: 0;
    background: linear-gradient(to right, var(--color-bg), transparent);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .portfolio-wrapper.is-scrolled::before {
    opacity: 1;
  }

  .portfolio-wrapper::after {
    right: 0;
    background: linear-gradient(to left, var(--color-bg), transparent);
  }

  .portfolio-track {
    display: flex;
    gap: var(--space-xl);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--container-padding);
    -webkit-overflow-scrolling: touch;
    padding-top: var(--space-lg);
    padding-bottom: var(--space-sm);
  }

  @media (max-width: 768px) {
    .portfolio-track {
      scrollbar-width: none;
    }

    .portfolio-track::-webkit-scrollbar {
      display: none;
    }
  }

  @media (min-width: 769px) {
    .portfolio-track {
      scrollbar-width: thin;
      scrollbar-color: var(--color-border-hover) var(--color-bg-card);
      padding-top: var(--space-lg);
      padding-bottom: var(--space-md);
    }

    .portfolio-track::-webkit-scrollbar {
      display: block;
      height: 8px;
    }

    .portfolio-track::-webkit-scrollbar-track {
      background: var(--color-bg-card);
      border-radius: 4px;
    }

    .portfolio-track::-webkit-scrollbar-thumb {
      background: var(--color-border-hover);
      border-radius: 4px;
      border: 2px solid var(--color-bg-card);
      transition: background var(--transition-fast);
    }

    .portfolio-track::-webkit-scrollbar-thumb:hover {
      background: var(--color-accent);
    }
  }

  .portfolio-card {
    flex: 0 0 380px;
    max-width: 85vw;
    scroll-snap-align: start;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    transition: border-color var(--transition-base), transform var(--transition-base);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }

  .portfolio-card:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-4px);
  }

  .portfolio-image-wrapper {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .portfolio-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .portfolio-card:hover .portfolio-image {
    transform: scale(1.04);
  }

  .portfolio-info {
    padding: var(--space-lg);
  }

  .portfolio-category {
    display: inline-block;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-xs);
  }

  .portfolio-title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
  }

  @media (max-width: 768px) {
    .portfolio-card {
      flex: 0 0 320px;
    }

    .portfolio-wrapper::before,
    .portfolio-wrapper::after {
      width: 24px;
    }
  }

  @media (max-width: 480px) {
    .portfolio-card {
      flex: 0 0 280px;
    }

    .portfolio-info {
      padding: var(--space-md);
    }

    .portfolio-title {
      font-size: var(--font-size-base);
    }

    .portfolio-wrapper::before,
    .portfolio-wrapper::after {
      width: 16px;
    }
  }
</style>
