---
import { getLangFromLocale, useTranslations } from '../i18n/utils'

const lang = getLangFromLocale(Astro.currentLocale)
const t = useTranslations(lang)
---

<section id="about" class="section about">
  <div class="container">
    <span class="section-label reveal">{t('about.label')}</span>
    <div class="about-grid">
      <div class="about-photo reveal reveal-delay-1">
        <div class="about-photo-wrapper">
          <img
            src="/images/avatar.png"
            alt={t('about.photoAlt')}
            class="about-image"
            width="480"
            height="480"
          />
          <div class="about-photo-border" aria-hidden="true"></div>
        </div>
      </div>

      <div class="about-content reveal reveal-delay-2">
        <h2 class="about-title">{t('about.name')}</h2>
        <p class="about-role">{t('about.role')}</p>

        <div class="about-text">
          <p>{t('about.text1')}</p>
          <p>{t('about.text2')}</p>
          <p>{t('about.text3')}</p>
        </div>

        <div class="about-stats">
          <div class="about-stat">
            <span class="about-stat-number">2+</span>
            <span class="about-stat-label">{t('about.stat.years')}</span>
          </div>
          <div class="about-stat">
            <span class="about-stat-number">5</span>
            <span class="about-stat-label">{t('about.stat.projects')}</span>
          </div>
          <div class="about-stat">
            <span class="about-stat-number">10K+</span>
            <span class="about-stat-label">{t('about.stat.users')}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--space-4xl);
    align-items: center;
  }

  .about-photo-wrapper {
    position: relative;
  }

  .about-image {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-lg);
    filter: grayscale(20%);
  }

  .about-photo-border {
    position: absolute;
    inset: 12px -12px -12px 12px;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-lg);
    opacity: 0.3;
    z-index: -1;
  }

  .about-title {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--space-sm);
  }

  .about-role {
    font-size: var(--font-size-base);
    color: var(--color-accent);
    font-weight: var(--font-weight-medium);
    margin-bottom: var(--space-xl);
  }

  .about-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-bottom: var(--space-2xl);
  }

  .about-text p {
    color: var(--color-text-secondary);
    line-height: var(--line-height-normal);
  }

  .about-stats {
    display: flex;
    gap: var(--space-2xl);
  }

  .about-stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .about-stat-number {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
  }

  .about-stat-label {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .about-photo-wrapper {
      max-width: 300px;
      margin-inline: auto;
    }

    .about-stats {
      gap: var(--space-xl);
    }

    .about-title {
      font-size: var(--font-size-2xl);
    }

    .about-text {
      margin-bottom: var(--space-xl);
    }

    .about-text p {
      font-size: var(--font-size-sm);
    }
  }

  @media (max-width: 480px) {
    .about-photo-wrapper {
      max-width: 220px;
    }

    .about-photo-border {
      display: none;
    }

    .about-role {
      margin-bottom: var(--space-lg);
    }

    .about-text {
      gap: var(--space-sm);
      margin-bottom: var(--space-lg);
    }

    .about-text p {
      font-size: var(--font-size-sm);
      line-height: 1.5;
    }

    .about-stats {
      justify-content: space-between;
      gap: var(--space-md);
    }

    .about-stat-number {
      font-size: var(--font-size-xl);
    }

    .about-stat-label {
      font-size: var(--font-size-xs);
    }
  }
</style>
