---
import { getCollection, render } from 'astro:content'
import { getLangFromLocale, useTranslations } from '../i18n/utils'

const lang = getLangFromLocale(Astro.currentLocale)
const t = useTranslations(lang)

const allTestimonials = await getCollection('testimonials', ({ data }) => data.lang === lang)
const testimonials = allTestimonials.sort((a, b) => a.data.order - b.data.order)

const rendered = await Promise.all(
  testimonials.map(async (entry) => {
    const { Content } = await render(entry)
    return { entry, Content }
  })
)
---

<section id="testimonials" class="section testimonials">
  <div class="container">
    <span class="section-label reveal">{t('testimonials.label')}</span>
    <h2 class="section-title reveal reveal-delay-1">{t('testimonials.title')}</h2>

    <div class="testimonials-wrapper reveal reveal-delay-2">
      <div class="testimonials-track">
        {rendered.map(({ entry, Content }) => (
          <article
            class="testimonial-card"
            data-source-url={entry.data.sourceUrl}
            tabindex={entry.data.sourceUrl ? 0 : undefined}
          >
            <div class="testimonial-quote" aria-hidden="true">"</div>

            <div class="testimonial-body">
              <Content />
            </div>

            <div class="testimonial-stars" aria-label={`${entry.data.rating} из 5`}>
              {Array.from({ length: 5 }).map((_, i) => (
                <span class:list={['star', { 'star--filled': i < entry.data.rating }]}>★</span>
              ))}
            </div>

            <footer class="testimonial-footer">
              <div class="testimonial-avatar" aria-hidden="true">
                {entry.data.avatar ? (
                  <img src={entry.data.avatar} alt="" width="48" height="48" class="testimonial-avatar-img" />
                ) : (
                  <span class="testimonial-avatar-initials">
                    {entry.data.author.split(' ').map((w: string) => w[0]).join('').slice(0, 2)}
                  </span>
                )}
              </div>
              <div class="testimonial-author-info">
                <span class="testimonial-author">{entry.data.author}</span>
                <span class="testimonial-role">{entry.data.role}</span>
              </div>
              {entry.data.projectUrl && (
                <a
                  href={entry.data.projectUrl}
                  class="testimonial-project"
                  aria-label={`${t('testimonials.project')}: ${entry.data.author}`}
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
                    <line x1="8" y1="21" x2="16" y2="21" />
                    <line x1="12" y1="17" x2="12" y2="21" />
                  </svg>
                  <span>{t('testimonials.project')}</span>
                </a>
              )}
              {entry.data.sourceUrl && (
                <a
                  href={entry.data.sourceUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="testimonial-source"
                  aria-label={`${t('testimonials.source')}: ${entry.data.author}`}
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    <polyline points="15 3 21 3 21 9" />
                    <line x1="10" y1="14" x2="21" y2="3" />
                  </svg>
                </a>
              )}
            </footer>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const wrapper = document.querySelector('.testimonials-wrapper') as HTMLElement
  const track = document.querySelector('.testimonials-track') as HTMLElement

  if (wrapper && track) {
    let isAutoScrollStopped = false
    let autoScrollInterval: number | undefined
    let isProgrammaticScroll = false

    const stopAutoScrollPermanently = () => {
      if (isAutoScrollStopped) return
      isAutoScrollStopped = true
      if (autoScrollInterval) {
        clearInterval(autoScrollInterval)
        autoScrollInterval = undefined
      }
    }

    wrapper.addEventListener('pointerdown', stopAutoScrollPermanently, { passive: true })
    wrapper.addEventListener('touchstart', stopAutoScrollPermanently, { passive: true })
    wrapper.addEventListener('wheel', stopAutoScrollPermanently, { passive: true })

    track.addEventListener('scroll', () => {
      wrapper.classList.toggle('is-scrolled', track.scrollLeft > 8)
      if (!isProgrammaticScroll) {
        stopAutoScrollPermanently()
      }
    }, { passive: true })

    const getClosestCardIndex = () => {
      const cards = Array.from(track.children) as HTMLElement[]
      if (cards.length === 0) return 0
      const firstOffset = cards[0].offsetLeft
      const currentScroll = track.scrollLeft
      let minDiff = Infinity
      let closestIdx = 0

      cards.forEach((card, idx) => {
        const pos = card.offsetLeft - firstOffset
        const diff = Math.abs(currentScroll - pos)
        if (diff < minDiff) {
          minDiff = diff
          closestIdx = idx
        }
      })
      return closestIdx
    }

    const startAutoScroll = () => {
      if (autoScrollInterval) clearInterval(autoScrollInterval)
      autoScrollInterval = window.setInterval(() => {
        if (isAutoScrollStopped) {
          if (autoScrollInterval) clearInterval(autoScrollInterval)
          return
        }
        const cards = Array.from(track.children) as HTMLElement[]
        if (cards.length < 2) return

        const maxScroll = track.scrollWidth - track.clientWidth
        if (maxScroll <= 0) return

        const currentIdx = getClosestCardIndex()
        let nextIdx = currentIdx + 1

        const firstOffset = cards[0].offsetLeft
        let targetLeft = cards[nextIdx] ? cards[nextIdx].offsetLeft - firstOffset : 0

        if (nextIdx >= cards.length || targetLeft > maxScroll + 5) {
          targetLeft = 0
        }

        isProgrammaticScroll = true
        track.scrollTo({ left: targetLeft, behavior: 'smooth' })
        setTimeout(() => {
          isProgrammaticScroll = false
        }, 800)
      }, 3500)
    }

    startAutoScroll()
  }

  const testimonialCards = document.querySelectorAll<HTMLElement>('.testimonial-card[data-source-url]')
  testimonialCards.forEach((card) => {
    card.addEventListener('click', (e) => {
      const target = e.target as HTMLElement
      if (target.closest('a') || target.closest('button')) {
        return
      }
      if (window.getSelection()?.toString()) {
        return
      }
      const url = card.dataset.sourceUrl
      if (url) {
        window.open(url, '_blank', 'noopener,noreferrer')
      }
    })

    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        const target = e.target as HTMLElement
        if (target.closest('a') || target.closest('button')) {
          return
        }
        e.preventDefault()
        const url = card.dataset.sourceUrl
        if (url) {
          window.open(url, '_blank', 'noopener,noreferrer')
        }
      }
    })
  })
</script>

<style>
  .testimonials-wrapper {
    position: relative;
  }

  /* fade edges to hint at scrollable content */
  .testimonials-wrapper::before,
  .testimonials-wrapper::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 48px;
    z-index: 2;
    pointer-events: none;
  }

  .testimonials-wrapper::before {
    left: 0;
    background: linear-gradient(to right, var(--color-bg), transparent);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .testimonials-wrapper.is-scrolled::before {
    opacity: 1;
  }

  .testimonials-wrapper::after {
    right: 0;
    background: linear-gradient(to left, var(--color-bg), transparent);
  }

  .testimonials-track {
    display: flex;
    gap: var(--space-xl);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--container-padding);
    -webkit-overflow-scrolling: touch;
    padding-top: var(--space-lg);
    padding-bottom: var(--space-sm);
  }

  @media (max-width: 768px) {
    .testimonials-track {
      scrollbar-width: none;
    }

    .testimonials-track::-webkit-scrollbar {
      display: none;
    }
  }

  @media (min-width: 769px) {
    .testimonials-track {
      scrollbar-width: thin;
      scrollbar-color: var(--color-border-hover) var(--color-bg-card);
      padding-top: var(--space-lg);
      padding-bottom: var(--space-md);
    }

    .testimonials-track::-webkit-scrollbar {
      display: block;
      height: 8px;
    }

    .testimonials-track::-webkit-scrollbar-track {
      background: var(--color-bg-card);
      border-radius: 4px;
    }

    .testimonials-track::-webkit-scrollbar-thumb {
      background: var(--color-border-hover);
      border-radius: 4px;
      border: 2px solid var(--color-bg-card);
      transition: background var(--transition-fast);
    }

    .testimonials-track::-webkit-scrollbar-thumb:hover {
      background: var(--color-accent);
    }
  }

  .testimonial-card {
    position: relative;
    flex: 0 0 380px;
    max-width: 85vw;
    padding: var(--space-2xl);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: border-color var(--transition-base), transform var(--transition-base);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    scroll-snap-align: start;
  }

  .testimonial-card[data-source-url] {
    cursor: pointer;
  }

  .testimonial-card:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-4px);
  }

  .testimonial-quote {
    font-size: 3rem;
    line-height: 1;
    color: var(--color-accent);
    opacity: 0.3;
    font-family: Georgia, serif;
    user-select: none;
    position: absolute;
    top: var(--space-lg);
    right: var(--space-xl);
  }

  .testimonial-body {
    flex: 1;
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-normal);
  }

  .testimonial-body :global(p) {
    margin: 0;
  }

  .testimonial-stars {
    display: flex;
    gap: 2px;
  }

  .star {
    font-size: var(--font-size-sm);
    color: var(--color-border);
    transition: color var(--transition-fast);
  }

  .star--filled {
    color: #F59E0B;
  }

  .testimonial-footer {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .testimonial-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--color-accent-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .testimonial-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .testimonial-avatar-initials {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .testimonial-author-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .testimonial-author {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .testimonial-role {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .testimonial-project {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
    transition: color var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
    margin-left: auto;
  }

  .testimonial-project:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-accent-subtle);
  }

  .testimonial-source {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    transition: color var(--transition-fast), background var(--transition-fast);
  }

  .testimonial-source:hover {
    color: var(--color-accent);
    background: var(--color-accent-subtle);
  }

  @media (max-width: 768px) {
    .testimonial-card {
      flex: 0 0 320px;
      padding: var(--space-xl);
    }

    .testimonials-wrapper::before,
    .testimonials-wrapper::after {
      width: 24px;
    }
  }

  @media (max-width: 480px) {
    .testimonial-card {
      flex: 0 0 280px;
      padding: var(--space-lg);
      gap: var(--space-md);
    }

    .testimonial-quote {
      font-size: 2rem;
      top: var(--space-md);
      right: var(--space-lg);
    }

    .testimonial-body {
      font-size: var(--font-size-xs);
    }

    .testimonial-avatar {
      width: 40px;
      height: 40px;
    }

    .testimonial-avatar-initials {
      font-size: var(--font-size-xs);
    }

    .testimonial-author {
      font-size: var(--font-size-xs);
    }

    .testimonial-role {
      font-size: 0.625rem;
    }

    .testimonials-wrapper::before,
    .testimonials-wrapper::after {
      width: 16px;
    }
  }
</style>
