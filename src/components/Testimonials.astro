---
import { getCollection, render } from 'astro:content'
import { getLangFromLocale, useTranslations } from '../i18n/utils'

const lang = getLangFromLocale(Astro.currentLocale)
const t = useTranslations(lang)

const allTestimonials = await getCollection('testimonials', ({ data }) => data.lang === lang)
const testimonials = allTestimonials.sort((a, b) => a.data.order - b.data.order)

const rendered = await Promise.all(
  testimonials.map(async (entry) => {
    const { Content } = await render(entry)
    return { entry, Content }
  })
)
---

<section id="testimonials" class="section testimonials">
  <div class="container">
    <span class="section-label reveal">{t('testimonials.label')}</span>
    <h2 class="section-title reveal reveal-delay-1">{t('testimonials.title')}</h2>

    <div class="testimonials-grid">
      {rendered.map(({ entry, Content }, index) => (
        <article class={`testimonial-card reveal reveal-delay-${(index % 4) + 1}`}>
          <div class="testimonial-quote" aria-hidden="true">"</div>

          <div class="testimonial-body">
            <Content />
          </div>

          <div class="testimonial-stars" aria-label={`${entry.data.rating} из 5`}>
            {Array.from({ length: 5 }).map((_, i) => (
              <span class:list={['star', { 'star--filled': i < entry.data.rating }]}>★</span>
            ))}
          </div>

          <footer class="testimonial-footer">
            <div class="testimonial-avatar" aria-hidden="true">
              {entry.data.avatar ? (
                <img src={entry.data.avatar} alt="" width="48" height="48" class="testimonial-avatar-img" />
              ) : (
                <span class="testimonial-avatar-initials">
                  {entry.data.author.split(' ').map((w: string) => w[0]).join('').slice(0, 2)}
                </span>
              )}
            </div>
            <div class="testimonial-author-info">
              <span class="testimonial-author">{entry.data.author}</span>
              <span class="testimonial-role">{entry.data.role}</span>
            </div>
            {entry.data.sourceUrl && (
              <a
                href={entry.data.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="testimonial-source"
                aria-label={`${t('testimonials.source')}: ${entry.data.author}`}
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                  <polyline points="15 3 21 3 21 9" />
                  <line x1="10" y1="14" x2="21" y2="3" />
                </svg>
              </a>
            )}
          </footer>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }

  .testimonial-card {
    position: relative;
    padding: var(--space-2xl);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: border-color var(--transition-base), transform var(--transition-base);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .testimonial-card:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-2px);
  }

  .testimonial-quote {
    font-size: 3rem;
    line-height: 1;
    color: var(--color-accent);
    opacity: 0.3;
    font-family: Georgia, serif;
    user-select: none;
    position: absolute;
    top: var(--space-lg);
    right: var(--space-xl);
  }

  .testimonial-body {
    flex: 1;
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-normal);
  }

  .testimonial-body :global(p) {
    margin: 0;
  }

  .testimonial-stars {
    display: flex;
    gap: 2px;
  }

  .star {
    font-size: var(--font-size-sm);
    color: var(--color-border);
    transition: color var(--transition-fast);
  }

  .star--filled {
    color: #F59E0B;
  }

  .testimonial-footer {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .testimonial-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--color-accent-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .testimonial-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .testimonial-avatar-initials {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .testimonial-author-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .testimonial-author {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .testimonial-role {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .testimonial-source {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    transition: color var(--transition-fast), background var(--transition-fast);
  }

  .testimonial-source:hover {
    color: var(--color-accent);
    background: var(--color-accent-subtle);
  }

  @media (max-width: 1024px) {
    .testimonials-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .testimonials-grid {
      grid-template-columns: 1fr;
    }

    .testimonial-card {
      padding: var(--space-xl);
    }
  }

  @media (max-width: 480px) {
    .testimonial-card {
      padding: var(--space-lg);
      gap: var(--space-md);
    }

    .testimonial-quote {
      font-size: 2rem;
      top: var(--space-md);
      right: var(--space-lg);
    }

    .testimonial-body {
      font-size: var(--font-size-xs);
    }

    .testimonial-avatar {
      width: 40px;
      height: 40px;
    }

    .testimonial-avatar-initials {
      font-size: var(--font-size-xs);
    }

    .testimonial-author {
      font-size: var(--font-size-xs);
    }

    .testimonial-role {
      font-size: 0.625rem;
    }
  }
</style>
